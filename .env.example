# Copy to .env and adjust for this host. .env is git-ignored.

# Host directory holding school-summary/ (config + storage)
PATH_TO_APPDATA=/mnt/user/appdata

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# uid:gid owning ${PATH_TO_APPDATA}/school-summary
APP_UID=10001
APP_GID=10001

# Upstream DNS resolvers for both containers
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8
